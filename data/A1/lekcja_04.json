{
  "lesson_metadata": {
    "id": "A1_04",
    "level": "A1",
    "title": "Moja rodzina i bliscy (Wygląd i charakter)"
  },
  "sections": [
    {
      "id": "sec_01",
      "type": "dialog",
      "title": "Diálogo: Mirando fotos",
      "content": [
        {"speaker": "Ana", "text": "Oye, ¿quién es esta chica rubia en la foto?"},
        {"speaker": "Piotr", "text": "Es mi mujer, Natalia. Y estas dos niñas son nuestras hijas."},
        {"speaker": "Ana", "text": "¡Qué guapas! ¿Y este hombre alto con gafas y barba?"},
        {"speaker": "Piotr", "text": "Es mi hermano mayor. Es muy inteligente y trabajador."}
      ]
    },
    {
      "id": "sec_02",
      "type": "vocabulary",
      "title": "Vocabulario (Rodzina i cechy)",
      "items": [
        {"es": "La familia", "pl": "Rodzina"},
        {"es": "El padre / La madre", "pl": "Ojciec / Matka"},
        {"es": "El marido / La mujer", "pl": "Mąż / Żona"},
        {"es": "El hijo / La hija", "pl": "Syn / Córka"},
        {"es": "Alto / Bajo", "pl": "Wysoki / Niski"},
        {"es": "Delgado / Gordo", "pl": "Szczupły / Gruby"},
        {"es": "Guapo / Feo", "pl": "Ładny / Brzydki"},
        {"es": "El pelo rubio / moreno", "pl": "Włosy blond / ciemne"},
        {"es": "Las gafas / La barba", "pl": "Okulary / Broda"},
        {"es": "Simpático / Inteligente", "pl": "Sympatyczny / Inteligentny"}
      ]
    },
    {
      "id": "sec_03",
      "type": "grammar",
      "title": "Gramatyka: SER, TENER, LLEVAR",
      "content": "Do opisu osób używamy trzech czasowników. SER (być) do cech stałych i charakteru. TENER (mieć) do części ciała (włosy, oczy). LLEVAR (nosić) do dodatków (okulary, broda)."
    },
    {
      "id": "sec_04",
      "type": "exercises",
      "title": "Ejercicios (Ćwiczenia 1-25)",
      "items": [
        {"question": "Mi ___ se llama Natalia.", "answer": "mujer", "translation": "Moja żona ma na imię Natalia."},
        {"question": "Tenemos dos ___ pequeñas.", "answer": "hijas", "translation": "Mamy dwie małe córki."},
        {"question": "Él ___ muy alto.", "answer": "es", "translation": "On jest bardzo wysoki."},
        {"question": "Ella ___ el pelo largo.", "answer": "tiene", "translation": "Ona ma długie włosy."},
        {"question": "Juan ___ gafas.", "answer": "lleva", "translation": "Juan nosi okulary."},
        {"question": "Mi abuelo no es joven, es ___.", "answer": "mayor", "translation": "Mój dziadek nie jest młody, jest starszy."},
        {"question": "Tengo los ___ azules.", "answer": "ojos", "translation": "Mam niebieskie oczy."},
        {"question": "Mi hermano es muy ___, estudia mucho.", "answer": "inteligente", "translation": "Mój brat jest bardzo inteligentny."},
        {"question": "Pedro no trabaja, es un poco ___.", "answer": "vago", "translation": "Pedro nie pracuje, jest trochę leniwy."},
        {"question": "El hermano de mi padre es mi ___.", "answer": "tío", "translation": "Brat mojego ojca to mój wujek."},
        {"question": "No tengo novia, estoy ___.", "answer": "soltero", "translation": "Nie mam dziewczyny, jestem singlem."},
        {"question": "Mis padres están ___ desde hace 20 años.", "answer": "casados", "translation": "Moi rodzice są małżeństwem."},
        {"question": "Esa ___ es mi prima.", "answer": "chica", "translation": "Ta dziewczyna to moja kuzynka."},
        {"question": "Tú ___ rubio.", "answer": "eres", "translation": "Ty jesteś blondynem."},
        {"question": "Yo ___ el pelo muy corto.", "answer": "tengo", "translation": "Mam bardzo krótkie włosy."},
        {"question": "Nosotros ___ simpáticos.", "answer": "somos", "translation": "My jesteśmy sympatyczni."},
        {"question": "Ella siempre ___ alegre.", "answer": "es", "translation": "Ona zawsze jest radosna."},
        {"question": "Mi tío lleva ___ y bigote.", "answer": "barba", "translation": "Mój wujek nosi brodę i wąsy."},
        {"question": "¿Tienes el ___ liso o rizado?", "answer": "pelo", "translation": "Masz proste czy kręcone włosy?"},
        {"question": "Luis es un hombre muy ___, siempre hace bromas.", "answer": "gracioso", "translation": "Luis to bardzo zabawny mężczyzna."},
        {"question": "Mi primo es un poco ___.", "answer": "tímido", "translation": "Mój kuzyn jest trochę nieśmiały."},
        {"question": "Tengo el pelo ___.", "answer": "moreno", "translation": "Mam ciemne włosy."},
        {"question": "Soy español, pero ___ en Polonia.", "answer": "vivo", "translation": "Mieszkam w Polsce."},
        {"question": "El niño ___ los ojos verdes.", "answer": "tiene", "translation": "Chłopiec ma zielone oczy."},
        {"question": "María es muy ___, habla con todos.", "answer": "abierta", "translation": "Maria jest bardzo otwarta."}
      ]
    },
    {
      "id": "sec_05",
      "type": "exercises",
      "title": "Ejercicios (Ćwiczenia 26-50)",
      "items": [
        {"question": "Mi hermano come mucho pero es muy ___.", "answer": "delgado", "translation": "Mój brat dużo je, ale jest bardzo szczupły."},
        {"question": "Mi abuela es la madre de mi ___.", "answer": "madre", "translation": "Moja babcia to matka mojej matki."},
        {"question": "Ese hombre ___ muy feo.", "answer": "es", "translation": "Ten mężczyzna jest bardzo brzydki."},
        {"question": "Mi hermana y yo ___ dos gatos.", "answer": "tenemos", "translation": "Moja siostra i ja mamy dwa koty."},
        {"question": "¿Usted ___ casado o soltero?", "answer": "está", "translation": "Jest Pan żonaty czy kawalerem?"},
        {"question": "¿Quién es ese ___ guapo?", "answer": "chico", "translation": "Kim jest ten przystojny chłopak?"},
        {"question": "Pablo es un chico muy ___.", "answer": "trabajador", "translation": "Pablo to bardzo pracowity chłopak."},
        {"question": "El hijo de mi tío es mi ___.", "answer": "primo", "translation": "Syn mojego wujka to mój kuzyn."},
        {"question": "La mujer de mi abuelo es mi ___.", "answer": "abuela", "translation": "Żona mojego dziadka to moja babcia."},
        {"question": "Mi hermana ___ el pelo pelirrojo.", "answer": "tiene", "translation": "Moja siostra ma rude włosy."},
        {"question": "No me gusta este chico, es muy ___.", "answer": "antipático", "translation": "Nie lubię tego chłopaka."},
        {"question": "El abuelo de mi hijo es mi ___.", "answer": "padre", "translation": "Dziadek mojego syna to mój ojciec."},
        {"question": "Mi kuzyn ___ gafas rojas.", "answer": "lleva", "translation": "Mój kuzyn nosi czerwone okulary."},
        {"question": "Esa mujer es muy ___.", "answer": "guapa", "translation": "Ta kobieta jest bardzo ładna."},
        {"question": "Susana está separada, ahora está ___.", "answer": "divorciada", "translation": "Susana jest rozwiedziona."},
        {"question": "¿Tú ___ los ojos marrones?", "answer": "tienes", "translation": "Czy ty masz brązowe oczy?"},
        {"question": "El bebé de mi hermano es mi ___.", "answer": "sobrino", "translation": "Dziecko mojego brata to mój siostrzeniec."},
        {"question": "Tengo el pelo ___ y rizado.", "answer": "corto", "translation": "Mam krótkie i kręcone włosy."},
        {"question": "Ustedes ___ muy simpáticos.", "answer": "son", "translation": "Państwo są bardzo sympatyczni."},
        {"question": "¿Vosotros ___ casados?", "answer": "estáis", "translation": "Jesteście małżeństwem?"},
        {"question": "Ese hombre mayor es ___.", "answer": "viudo", "translation": "Ten starszy mężczyzna jest wdowcem."},
        {"question": "El hijo de mi hijo es mi ___.", "answer": "nieto", "translation": "Syn mojego syna to mój wnuk."},
        {"question": "La córka mojej córki to moja ___.", "answer": "nieta", "translation": "La hija de mi hija es mi nieta."},
        {"question": "Mi padre es ___.", "answer": "alto", "translation": "Mój ojciec jest wysoki."},
        {"question": "Ella ___ inteligente.", "answer": "es", "translation": "Ona jest inteligentna."}
      ]
    }
  ]
}
