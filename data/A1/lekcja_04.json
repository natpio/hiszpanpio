{
  "lesson_metadata": {
    "id": "A1_04",
    "level": "A1",
    "title": "Moja rodzina i bliscy (Wygląd i charakter)"
  },
  "sections": {
    "dialog": {
      "title": "Diálogo: Mirando fotos (Oglądając zdjęcia)",
      "content": [
        {"speaker": "Ana", "text": "Oye, ¿quién es esta chica rubia en la foto?"},
        {"speaker": "Piotr", "text": "Es mi mujer, Natalia. Y estas dos niñas son nuestras hijas."},
        {"speaker": "Ana", "text": "¡Qué guapas! ¿Y este hombre alto con gafas y barba?"},
        {"speaker": "Piotr", "text": "Es mi hermano mayor. Es muy inteligente y trabajador, pero a veces un poco serio."}
      ]
    },
    "reading": {
      "title": "Lectura (Czytanie)",
      "text": "Mi familia es bastante grande. Mis padres están casados desde hace treinta años. Mi padre es alto, delgado y tiene el pelo gris. Lleva gafas. Mi madre es más baja y tiene los ojos azules. Yo tengo un hermano y una hermana. Mi hermana está soltera y es muy abierta y simpática. Mi hermano está divorciado y es un poco tímido."
    },
    "grammar": {
      "title": "Gramatyka: Opisywanie osób (Ser, Tener, Llevar)",
      "explanation": "Do opisu osób używamy trzech czasowników. SER (być) - do cech stałych i charakteru (np. jest wysoki, jest miły). TENER (mieć) - do części ciała (np. ma niebieskie oczy, krótkie włosy). LLEVAR (nosić) - do dodatków (np. nosi okulary, nosi brodę).",
      "table": [
        ["Czasownik", "Zastosowanie", "Przykłady"],
        ["SER", "Wygląd ogólny i charakter", "es alto (jest wysoki), es simpático (jest miły)"],
        ["TENER", "Włosy, oczy, wiek", "tiene el pelo rubio (ma blond włosy), tiene 30 años"],
        ["LLEVAR", "Okulary, broda, wąsy, ubrania", "lleva gafas (nosi okulary), lleva barba (nosi brodę)"]
      ]
    },
