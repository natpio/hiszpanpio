      "id": "sec_01",
      "type": "dialog",
      "title": "Diálogo: En la calle (Na ulicy)",
      "content": [
        {"speaker": "Ana", "text": "¡Hola! Buenos días. ¿Cómo te llamas?"},
        {"speaker": "Piotr", "text": "Hola, buenos días. Me llamo Piotr, ¿y tú?"},
        {"speaker": "Ana", "text": "Yo soy Ana. Encantada."},
        {"speaker": "Piotr", "text": "Igualmente."}
      ]
    },
    {
