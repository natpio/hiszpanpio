    {
      "id": "sec_03",
      "type": "grammar",
      "title": "Gramatyka: Czasownik SER (być)",
      "content": "Czasownik 'ser' jest nieregularny. Używamy go do opisywania cech stałych, zawodu, pochodzenia oraz do przedstawiania się."
    },
