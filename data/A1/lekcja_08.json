    {
      "id": "sec_03",
      "type": "grammar",
      "title": "Gramatyka: Czasownik GUSTAR",
      "content": "Czasownik 'gustar' (smakować / podobać się) działa inaczej niż w języku polskim. Dosłownie oznacza 'coś sprawia mi przyjemność'. Jeśli podoba Ci się JEDNA rzecz, używasz 'gusta' (np. Me gusta la carne). Jeśli podoba Ci się KILKA rzeczy, używasz 'gustan' (np. Me gustan los tomates). Osoby: me (mi), te (ci), le (jemu/jej), nos (nam), os (wam), les (im)."
    },
    {
      "id": "sec_04",
      "type": "exercises",
      "title": "Ejercicios (Ćwiczenia 1-25)",
      "items": [
        {"question": "A mí me ___ la sopa.", "answer": "gusta", "translation": "Mi smakuje zupa."},
        {"question": "Me ___ los tomates frescos.", "answer": "gustan", "translation": "Smakują mi świeże pomidory."},
        {"question": "¿Te ___ el vino tinto?", "answer": "gusta", "translation": "Smakuje ci czerwone wino?"},
        {"question": "A Natalia le ___ las manzanas.", "answer": "gustan", "translation": "Natalii smakują jabłka."},
        {"question": "Nos ___ mucho la comida española.", "answer": "gusta", "translation": "Bardzo smakuje nam hiszpańskie jedzenie."},
        {"question": "No me ___ el pescado crudo.", "answer": "gusta", "translation": "Nie smakuje mi surowa ryba."},
        {"question": "¿Os ___ los postres dulces?", "answer": "gustan", "translation": "Smakują wam słodkie desery?"},
        {"question": "A las niñas les ___ el helado.", "answer": "gusta", "translation": "Dziewczynkom smakują lody. (Lody jako rzeczownik niepoliczalny w l.p.)"},
        {"question": "Me ___ mucho este queso artesanal.", "answer": "gusta", "translation": "Bardzo smakuje mi ten rzemieślniczy ser."},
        {"question": "A él le ___ los embutidos.", "answer": "gustan", "translation": "Jemu smakują wędliny."},
        {"question": "Yo ___ pan con mantequilla.", "answer": "como", "translation": "Jem chleb z masłem."},
        {"question": "Nosotros ___ agua sin gas.", "answer": "bebemos", "translation": "My pijemy wodę niegazowaną."},
        {"question": "Yo ___ una copa de vino, por favor.", "answer": "quiero", "translation": "Poproszę (Chcę) kieliszek wina."},
        {"question": "¿Qué vas a ___?", "answer": "tomar", "translation": "Czego się napijesz? (Co weźmiesz?)"},
        {"question": "Él ___ pollo asado con patatas.", "answer": "come", "translation": "On je pieczonego kurczaka z ziemniakami."},
        {"question": "Ellas ___ zumo de naranja.", "answer": "beben", "translation": "One piją sok pomarańczowy."},
        {"question": "Mis hijas ___ helado de chocolate.", "answer": "quieren", "translation": "Moje córki chcą lody czekoladowe."},
        {"question": "Por la mañana ___ un café negro.", "answer": "tomo", "translation": "Rano piję (biorę) czarną kawę."},
        {"question": "¿___ postre, por favor?", "answer": "Quieres", "translation": "Chcesz deser, proszę?"},
        {"question": "En España se ___ muy tarde.", "answer": "come", "translation": "W Hiszpanii jada się bardzo późno."},
        {"question": "Para hacer la ensalada necesito un ___.", "answer": "tomate", "translation": "Żeby zrobić sałatkę, potrzebuję pomidora."},
        {"question": "El ___ es una fruta larga y amarilla.", "answer": "plátano", "translation": "Banan to długi i żółty owoc."},
        {"question": "La ___ es una fruta redonda y verde.", "answer": "manzana", "translation": "Jabłko to okrągły i zielony owoc."},
        {"question": "Bebo una ___ de vino blanco.", "answer": "copa", "translation": "Piję kieliszek białego wina."},
        {"question": "Tomo un ___ de agua fría.", "answer": "vaso", "translation": "Piję (biorę) szklankę zimnej wody."}
      ]
    },
    {
      "id": "sec_05",
      "type": "exercises",
      "title": "Ejercicios (Ćwiczenia 26-50)",
      "items": [
        {"question": "Para cortar la carne necesito un ___.", "answer": "cuchillo", "translation": "Żeby pokroić mięso, potrzebuję noża."},
        {"question": "Como la sopa con una ___.", "answer": "cuchara", "translation": "Jem zupę łyżką."},
        {"question": "Pincho la ensalada con el ___.", "answer": "tenedor", "translation": "Nabijam sałatkę widelcem."},
        {"question": "El camarero pone el ___ en la mesa.", "answer": "plato", "translation": "Kelner kładzie talerz na stole."},
        {"question": "Límpiate la boca con la ___.", "answer": "servilleta", "translation": "Wytrzyj usta serwetką."},
        {"question": "Hacemos ___ de forma artesanal.", "answer": "salchichas", "translation": "Robimy kiełbasy rzemieślniczo."},
        {"question": "La comida no es dulce, es ___.", "answer": "salada", "translation": "Jedzenie nie jest słodkie, jest słone."},
        {"question": "Este pastel es muy ___.", "answer": "dulce", "translation": "To ciasto jest bardzo słodkie."},
        {"question": "Me encanta el sabor ___ de México.", "answer": "picante", "translation": "Uwielbiam pikantny smak z Meksyku."},
        {"question": "El té con ___ es amarillo.", "answer": "limón", "translation": "Herbata z cytryną jest żółta."},
        {"question": "El ___ nos trae la carta.", "answer": "camarero", "translation": "Kelner przynosi nam kartę."},
        {"question": "Miramos el ___ para elegir la comida.", "answer": "menú", "translation": "Patrzymy w menu, żeby wybrać jedzenie."},
        {"question": "Al final de la cena, pedimos la ___.", "answer": "cuenta", "translation": "Na koniec kolacji prosimy o rachunek."},
        {"question": "Dejamos una ___ para el camarero.", "answer": "propina", "translation": "Zostawiamy napiwek dla kelnera."},
        {"question": "La ___ está reservada para cuatro personas.", "answer": "mesa", "translation": "Stół (stolik) jest zarezerwowany dla czterech osób."},
        {"question": "De primero, quiero una ___ de tomate.", "answer": "sopa", "translation": "Na pierwsze danie chcę zupę pomidorową."},
        {"question": "De segundo, ___ con verduras.", "answer": "carne", "translation": "Na drugie danie mięso z warzywami."},
        {"question": "De ___, una tarta de manzana.", "answer": "postre", "translation": "Na deser ciasto (szarlotka) z jabłkami."},
        {"question": "El ___ de vainilla está muy frío.", "answer": "helado", "translation": "Lody waniliowe są bardzo zimne."},
        {"question": "El ___ tinto se bebe con la carne.", "answer": "vino", "translation": "Czerwone wino pije się do mięsa."},
        {"question": "No quiero agua, prefiero una ___ fría.", "answer": "cerveza", "translation": "Nie chcę wody, wolę zimne piwo."},
        {"question": "Me gusta el pan caliente con ___.", "answer": "mantequilla", "translation": "Lubię ciepły chleb z masłem."},
        {"question": "Para la tortilla necesito patatas y ___.", "answer": "cebolla", "translation": "Do tortilli potrzebuję ziemniaków i cebuli."},
        {"question": "Siempre pido queso y ___ ibérico.", "answer": "jamón", "translation": "Zawsze zamawiam ser i szynkę iberyjską."},
        {"question": "La comida en este restaurante es ___.", "answer": "deliciosa", "translation": "Jedzenie w tej restauracji jest pyszne."}
      ]
    }
  ]
