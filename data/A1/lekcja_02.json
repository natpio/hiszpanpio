  "sections": {
    "dialog": {
      "title": "Diálogo: En el aeropuerto (Na lotnisku)",
      "content": [
        {"speaker": "Oficial", "text": "Buenos días. ¿De dónde es usted?"},
        {"speaker": "Piotr", "text": "Soy de Polonia, vivo en Poznań."},
        {"speaker": "Oficial", "text": "¿Y a qué se dedica?"},
        {"speaker": "Piotr", "text": "Soy especialista en logística. Trabajo en una empresa internacional."}
      ]
    },
    "reading": {
      "title": "Lectura (Czytanie)",
      "text": "Mi equipo de trabajo es muy internacional. Carlos es de España y habla inglés y español. Anna es de Alemania, pero vive en Madrid. Yo soy polaco y estudio español todos los días."
    },
    "grammar": {
      "title": "Gramatyka: Czasowniki regularne (-ar, -er, -ir)",
      "explanation": "W języku hiszpańskim czasowniki dzielą się na trzy grupy w zależności od końcówki bezokolicznika: -ar (np. trabajar), -er (np. comer), -ir (np. vivir). Odmieniając je w czasie teraźniejszym, odcinamy końcówkę i dodajemy odpowiednią literę dla danej osoby.",
      "table": [
        ["Osoba", "-AR (trabajar - pracować)", "-ER (comer - jeść)", "-IR (vivir - żyć/mieszkać)"],
        ["Yo (ja)", "trabaj-o", "com-o", "viv-o"],
        ["Tú (ty)", "trabaj-as", "com-es", "viv-es"],
        ["Él/Ella/Usted (on/ona/Pan)", "trabaj-a", "com-e", "viv-e"]
      ]
    },
