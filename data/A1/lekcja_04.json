    "exercises": [
      {"id": "A1_04_e01", "type": "fill_gap", "question": "Mi ___ se llama Natalia.", "answer": "mujer", "translation": "Moja żona ma na imię Natalia."},
      {"id": "A1_04_e02", "type": "fill_gap", "question": "Tenemos dos ___ pequeñas.", "answer": "hijas", "translation": "Mamy dwie małe córki."},
      {"id": "A1_04_e03", "type": "fill_gap", "question": "Mi ___ se llama Carlos.", "answer": "padre", "translation": "Mój ojciec ma na imię Carlos."},
      {"id": "A1_04_e04", "type": "fill_gap", "question": "Ana es la ___ de mis padres.", "answer": "hija", "translation": "Ana to córka moich rodziców."},
      {"id": "A1_04_e05", "type": "fill_gap", "question": "Él ___ muy alto.", "answer": "es", "translation": "On jest bardzo wysoki."},
      {"id": "A1_04_e06", "type": "fill_gap", "question": "Ella ___ el pelo largo.", "answer": "tiene", "translation": "Ona ma długie włosy."},
      {"id": "A1_04_e07", "type": "fill_gap", "question": "Juan ___ gafas.", "answer": "lleva", "translation": "Juan nosi okulary."},
      {"id": "A1_04_e08", "type": "fill_gap", "question": "Mi abuelo no es joven, es ___.", "answer": "mayor", "translation": "Mój dziadek nie jest młody, jest starszy."},
      {"id": "A1_04_e09", "type": "fill_gap", "question": "Tengo los ___ azules.", "answer": "ojos", "translation": "Mam niebieskie oczy."},
      {"id": "A1_04_e10", "type": "fill_gap", "question": "Mi hermano es muy ___, estudia mucho.", "answer": "inteligente", "translation": "Mój brat jest bardzo inteligentny, dużo się uczy."},
      {"id": "A1_04_e11", "type": "fill_gap", "question": "Pedro no trabaja, es un poco ___.", "answer": "vago", "translation": "Pedro nie pracuje, jest trochę leniwy."},
      {"id": "A1_04_e12", "type": "fill_gap", "question": "El hermano de mi padre es mi ___.", "answer": "tío", "translation": "Brat mojego ojca to mój wujek."},
      {"id": "A1_04_e13", "type": "fill_gap", "question": "No tengo novia, estoy ___.", "answer": "soltero", "translation": "Nie mam dziewczyny, jestem singlem."},
      {"id": "A1_04_e14", "type": "fill_gap", "question": "Mis padres están ___ desde hace 20 años.", "answer": "casados", "translation": "Moi rodzice są małżeństwem od 20 lat."},
      {"id": "A1_04_e15", "type": "fill_gap", "question": "Esa ___ es mi prima.", "answer": "chica", "translation": "Ta dziewczyna to moja kuzynka."},
      {"id": "A1_04_e16", "type": "fill_gap", "question": "Tú ___ rubio.", "answer": "eres", "translation": "Ty jesteś blondynem."},
      {"id": "A1_04_e17", "type": "fill_gap", "question": "Yo ___ el pelo muy corto.", "answer": "tengo", "translation": "Mam bardzo krótkie włosy."},
      {"id": "A1_04_e18", "type": "fill_gap", "question": "Nosotros ___ simpáticos.", "answer": "somos", "translation": "My jesteśmy sympatyczni."},
      {"id": "A1_04_e19", "type": "fill_gap", "question": "Ella siempre ___ alegre.", "answer": "es", "translation": "Ona zawsze jest radosna."},
      {"id": "A1_04_e20", "type": "fill_gap", "question": "Mi tío lleva ___ y bigote.", "answer": "barba", "translation": "Mój wujek nosi brodę i wąsy."},
      {"id": "A1_04_e21", "type": "fill_gap", "question": "¿Tienes el ___ liso o rizado?", "answer": "pelo", "translation": "Masz proste czy kręcone włosy?"},
      {"id": "A1_04_e22", "type": "fill_gap", "question": "Luis es un hombre muy ___, siempre hace bromas.", "answer": "gracioso", "translation": "Luis to bardzo zabawny mężczyzna, zawsze żartuje."},
      {"id": "A1_04_e23", "type": "fill_gap", "question": "Mi primo es un poco ___, no habla con la gente.", "answer": "tímido", "translation": "Mój kuzyn jest trochę nieśmiały, nie rozmawia z ludźmi."},
      {"id": "A1_04_e24", "type": "fill_gap", "question": "Tengo el pelo ___.", "answer": "moreno", "translation": "Mam ciemne włosy."},
      {"id": "A1_04_e25", "type": "fill_gap", "question": "Soy español, pero ___ en Polonia.", "answer": "vivo", "translation": "Jestem Hiszpanem, ale mieszkam w Polsce."},
      {"id": "A1_04_e26", "type": "fill_gap", "question": "El niño ___ los ojos verdes.", "answer": "tiene", "translation": "Chłopiec ma zielone oczy."},
      {"id": "A1_04_e27", "type": "fill_gap", "question": "María es muy ___, habla con todos.", "answer": "abierta", "translation": "Maria jest bardzo otwarta, rozmawia ze wszystkimi."},
      {"id": "A1_04_e28", "type": "fill_gap", "question": "Mi hermano come mucho pero es muy ___.", "answer": "delgado", "translation": "Mój brat dużo je, ale jest bardzo chudy."},
      {"id": "A1_04_e29", "type": "fill_gap", "question": "Mi abuela es la madre de mi ___.", "answer": "madre", "translation": "Moja babcia to matka mojej matki."},
      {"id": "A1_04_e30", "type": "fill_gap", "question": "Ese hombre ___ muy feo.", "answer": "es", "translation": "Ten mężczyzna jest bardzo brzydki."},
      {"id": "A1_04_e31", "type": "fill_gap", "question": "Mi hermana y yo ___ dos gatos.", "answer": "tenemos", "translation": "Moja siostra i ja mamy dwa koty."},
      {"id": "A1_04_e32", "type": "fill_gap", "question": "¿Usted ___ casado o soltero?", "answer": "está", "translation": "Jest Pan żonaty czy kawalerem?"},
      {"id": "A1_04_e33", "type": "fill_gap", "question": "¿Quién es ese ___ guapo?", "answer": "chico", "translation": "Kim jest ten przystojny chłopak?"},
      {"id": "A1_04_e34", "type": "fill_gap", "question": "Pablo es un chico muy ___.", "answer": "trabajador", "translation": "Pablo to bardzo pracowity chłopak."},
      {"id": "A1_04_e35", "type": "fill_gap", "question": "El hijo de mi tío es mi ___.", "answer": "primo", "translation": "Syn mojego wujka to mój kuzyn."},
      {"id": "A1_04_e36", "type": "fill_gap", "question": "La mujer de mi abuelo es mi ___.", "answer": "abuela", "translation": "Żona mojego dziadka to moja babcia."},
      {"id": "A1_04_e37", "type": "fill_gap", "question": "Mi hermana ___ el pelo pelirrojo.", "answer": "tiene", "translation": "Moja siostra ma rude włosy."},
      {"id": "A1_04_e38", "type": "fill_gap", "question": "No me gusta este chico, es muy ___.", "answer": "antipático", "translation": "Nie lubię tego chłopaka, jest bardzo niesympatyczny."},
      {"id": "A1_04_e39", "type": "fill_gap", "question": "El abuelo de mi hijo es mi ___.", "answer": "padre", "translation": "Dziadek mojego syna to mój ojciec."},
      {"id": "A1_04_e40", "type": "fill_gap", "question": "Mi primo ___ gafas rojas.", "answer": "lleva", "translation": "Mój kuzyn nosi czerwone okulary."},
      {"id": "A1_04_e41", "type": "fill_gap", "question": "Esa mujer es muy ___.", "answer": "guapa", "translation": "Ta kobieta jest bardzo ładna."},
      {"id": "A1_04_e42", "type": "fill_gap", "question": "Susana está separada, ahora está ___.", "answer": "divorciada", "translation": "Susana jest w separacji, teraz jest rozwiedziona."},
