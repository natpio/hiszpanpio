{
  "lesson_metadata": {
    "id": "A1_02",
    "level": "A1",
    "title": "Skąd jesteś? Kraje i zawody"
  },
  "sections": [
    {
      "id": "sec_01",
      "type": "dialog",
      "title": "Diálogo: En el aeropuerto (Na lotnisku)",
      "content": [
        {"speaker": "Oficial", "text": "Buenos días. ¿De dónde es usted?"},
        {"speaker": "Piotr", "text": "Soy de Polonia, vivo en Poznań."},
        {"speaker": "Oficial", "text": "¿Y a qué se dedica?"},
        {"speaker": "Piotr", "text": "Soy especialista en logística. Trabajo en una empresa internacional."}
      ]
    },
    {
      "id": "sec_02",
      "type": "vocabulary",
      "title": "Vocabulario (Kraje i zawody)",
      "items": [
        {"es": "¿De dónde eres?", "pl": "Skąd jesteś?"},
        {"es": "Vivir", "pl": "Mieszkać / Żyć"},
        {"es": "Trabajar", "pl": "Pracować"},
        {"es": "Hablar", "pl": "Mówić"},
        {"es": "El país", "pl": "Kraj"},
        {"es": "El idioma", "pl": "Język (mowa)"},
        {"es": "¿A qué te dedicas?", "pl": "Czym się zajmujesz? (zawodowo)"}
      ]
    },
    {
      "id": "sec_03",
      "type": "grammar",
      "title": "Gramatyka: Czasowniki regularne (-ar, -er, -ir)",
      "content": "W języku hiszpańskim czasowniki dzielą się na trzy grupy w zależności od końcówki bezokolicznika: -ar (np. trabajar), -er (np. comer), -ir (np. vivir). Odmieniając je w czasie teraźniejszym, odcinamy końcówkę i dodajemy odpowiednią literę dla danej osoby."
    },
    {
      "id": "sec_04",
      "type": "exercises",
      "title": "Ejercicios (Ćwiczenia)",
      "items": [
        {
          "question": "Yo ___ en Polonia.",
          "answer": "vivo",
          "translation": "Ja mieszkam w Polsce."
        },
        {
          "question": "¿Tú ___ español?",
          "answer": "hablas",
          "translation": "Czy ty mówisz po hiszpańsku?"
        },
        {
          "question": "Carlos ___ en una empresa internacional.",
          "answer": "trabaja",
          "translation": "Carlos pracuje w międzynarodowej firmie."
        },
        {
          "question": "Anna ___ de Alemania.",
          "answer": "es",
          "translation": "Anna jest z Niemiec."
        }
      ]
    }
  ]
}
